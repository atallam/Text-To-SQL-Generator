# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
LLM_MODEL_GENERATION=claude-sonnet-5-5
LLM_MODEL_JUDGE=claude-haiku-5-5

DEFAULT_SOURCE=wealthlens
LOG_LEVEL=INFO
LOG_JSON=false

# Local docker-compose Postgres (synthetic WealthLens data)
POSTGRES_PASSWORD=postgres
WEALTHLENS_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wealthlens
WEALTHLENS_READONLY_URL=postgresql+psycopg://t2s_readonly:change-me@localhost:5432/wealthlens
WEALTHLENS_READONLY_PASSWORD=change-me

# Supabase: use the DIRECT or SESSION pooler connection string, not the transaction pooler (port 6543).

# Langfuse (optional until the Langfuse adapter lands)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

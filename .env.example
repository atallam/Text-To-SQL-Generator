# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
LLM_MODEL_GENERATION=claude-sonnet-5-5
LLM_MODEL_JUDGE=claude-haiku-5-5

DEFAULT_SOURCE=wealthlens
LOG_LEVEL=INFO
LOG_JSON=false

# Local docker-compose Postgres (synthetic WealthLens data)
POSTGRES_PASSWORD=postgres
WEALTHLENS_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wealthlens
WEALTHLENS_READONLY_URL=postgresql+psycopg://t2s_readonly:change-me@localhost:5432/wealthlens
WEALTHLENS_READONLY_PASSWORD=change-me

# Supabase: use the DIRECT or SESSION pooler connection string, not the transaction pooler (port 6543).

# Langfuse (optional until the Langfuse adapter lands)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# API (Phase 4). The API refuses requests until API_KEYS is set. Use long random strings, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
API_KEY=
# Optional: keys allowed to approve or reject feedback (the review queue)
API_ADMIN_KEYS=
API_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_RATE_LIMIT_PER_MINUTE=30
